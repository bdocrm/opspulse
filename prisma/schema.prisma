generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CEO
  COLLECTOR
  OM
  AGENT
}

model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  password          String
  role              Role
  // Legacy / "primary" campaign. Kept for backward compatibility: every code
  // path that read a single campaign still works, and it mirrors the first
  // entry of the multi-campaign assignment (see UserCampaign). For COLLECTOR/OM
  // users the full set of assigned campaigns lives in `campaignAssignments`.
  campaignId        String?
  campaign          Campaign?          @relation(fields: [campaignId], references: [id])
  campaignAssignments UserCampaign[]   // Multi-campaign assignment (collectors/managers)
  seatNumber        Int?
  monthlyTarget     Float? // Current target for this agent (NTB target for ACQ campaigns)
  monthlyTargetSupplementary Float? // ACQ: Supplementary target for this agent
  // MB PL per-agent goals (auto-filled from level, overridable)
  mbLevel               String? // PAYROLL SU2 / PAYROLL HYBRID-ROOKIE / DEPO HYBRID / PAYROLL HYBRID
  disbursedTxnTarget    Float?
  disbursedVolTarget    Float?
  grossTurnInsTxnTarget Float?
  grossTurnInsVolTarget Float?
  dailySales        DailySales[]
  targetHistory     AgentTarget[]
  productionDetails ProductionDetail[] // AGENT produces production details
  createdAt         DateTime           @default(now())

  @@index([campaignId])
}

// Explicit many-to-many join between users and campaigns. Lets a single
// collector/manager be assigned to multiple campaigns at once while the legacy
// User.campaignId continues to hold the "primary" campaign for backward
// compatibility. The unique constraint guarantees no duplicate assignments.
model UserCampaign {
  id         String   @id @default(uuid())
  userId     String
  campaignId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, campaignId])
  @@index([userId])
  @@index([campaignId])
}

model Campaign {
  id                String             @id @default(uuid())
  campaignName      String
  goalType          String
  monthlyGoal       Float // Legacy field, kept for backwards compatibility
  supplementaryGoal Float              @default(0) // ACQ: monthly Supplementary goal (NTB uses monthlyGoal)
  kpiMetric         String // Legacy field, kept for backwards compatibility
  workingDays       Int                @default(22) // Configurable working days per month
  daysLapsed        Int                @default(0) // Manually set days lapsed for run rate
  metrics           CampaignMetric[] // New: Multiple KPI metrics per campaign
  monthlyGoals      CampaignGoal[] // Per-month goal configurations
  users             User[]
  userAssignments   UserCampaign[] // Multi-campaign assignment (collectors/managers)
  dailySales        DailySales[]
  productionDetails ProductionDetail[] // Production details for this campaign
  createdAt         DateTime           @default(now())
}

// Per-(campaign, month, year) goal configuration. Lets the same campaign keep
// independent monthly goal / run-rate settings (e.g. BPI PA OUTBOUND → January
// vs February). When a row is absent for a given month, callers fall back to the
// legacy Campaign-level fields for backward compatibility.
model CampaignGoal {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  month       Int // 1-12
  year        Int
  monthlyGoal Float    @default(0)
  supplementaryGoal Float @default(0) // ACQ: per-month Supplementary goal
  kpiMetric   String   @default("transmittals")
  workingDays Int      @default(22)
  daysLapsed  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([campaignId, month, year])
  @@index([campaignId])
}

model CampaignMetric {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  metricName  String // e.g., "transmittals", "approvals", "activations", "booked"
  monthlyGoal Float // Goal for this specific metric
  createdAt   DateTime @default(now())

  @@unique([campaignId, metricName]) // One metric type per campaign
  @@index([campaignId])
}

model DailySales {
  id             String   @id @default(uuid())
  userId         String
  campaignId     String
  date           DateTime
  transmittals   BigInt   @default(0)
  activations    BigInt   @default(0)
  approvals      BigInt   @default(0)
  booked         BigInt   @default(0)
  qualityRate    Float?
  conversionRate Float?
  volume         BigInt   @default(0)
  transaction    BigInt   @default(0)
  present        Boolean  @default(true)
  absent         Boolean  @default(false)
  user           User     @relation(fields: [userId], references: [id])
  campaign       Campaign @relation(fields: [campaignId], references: [id])
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([campaignId])
  @@index([date])
}

model ProductionEntry {
  id          String             @id @default(uuid())
  campaignId  String
  date        DateTime // Date of entry (e.g., 2026-03-05)
  time        String // Time string (e.g., "2:36 PM")
  createdBy   String // Collector ID
  periodStart DateTime? // Start of the reporting period (e.g. MTD May 1) for bulk imports
  periodEnd   DateTime? // End of the reporting period (e.g. MTD May 31) for bulk imports
  importFileName String? // Original uploaded file name for bulk imports
  importMetricType String? // Metric mode used for the import
  details     ProductionDetail[]
  createdAt   DateTime           @default(now())

  @@index([campaignId])
  @@index([date])
}

model ProductionDetail {
  id                String          @id @default(uuid())
  productionEntryId String
  productionEntry   ProductionEntry @relation(fields: [productionEntryId], references: [id], onDelete: Cascade)
  agentId           String
  agent             User            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  campaignId        String // Direct reference to campaign for easier filtering
  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  transmittals      BigInt          @default(0)
  activations       BigInt          @default(0)
  approvals         BigInt          @default(0)
  booked            BigInt          @default(0)
  qualityRate       Float?
  conversionRate    Float?
  volume            BigInt          @default(0)
  transmittedVolume BigInt          @default(0)
  approvalsVolume   BigInt          @default(0)
  bookedVolume      BigInt          @default(0)
  sourceSheet       String?
  agentLevel        String?
  dateHired         DateTime?
  agentType         String?
  monthlyGoal       Float?
  monthlyActual     Float?
  monthlyAchievement Float?
  overallGoal       Float?
  overallActual     Float?
  overallAchievement Float?
  transaction       BigInt          @default(0)
  ntb               BigInt          @default(0) // ACQ: New-To-Bank accounts
  supplementary     BigInt          @default(0) // ACQ: supplementary accounts
  seatCategory      String? // ACQ: BILLABLE / BUFFER
  // MB PL wide-format: per-category transaction counts + volume
  bauPayrollTxn      BigInt         @default(0)
  bauPayrollVol      BigInt         @default(0)
  bauDepositorTxn    BigInt         @default(0)
  bauDepositorVol    BigInt         @default(0)
  topupPayrollTxn    BigInt         @default(0)
  topupPayrollVol    BigInt         @default(0)
  topupDepositorTxn  BigInt         @default(0)
  topupDepositorVol  BigInt         @default(0)
  openMarketTxn      BigInt         @default(0)
  openMarketVol      BigInt         @default(0)
  // MB PA wide-format: TOTAL (C2G / BT / BalCon PA) + GRAND TOTAL
  c2gTxn            BigInt          @default(0)
  c2gVol            BigInt          @default(0)
  btTxn             BigInt          @default(0)
  btVol             BigInt          @default(0)
  balconTxn         BigInt          @default(0)
  balconVol         BigInt          @default(0)
  grandTotalTxn     BigInt          @default(0)
  grandTotalVol     BigInt          @default(0)
  createdAt         DateTime        @default(now())

  @@unique([productionEntryId, agentId])
  @@index([productionEntryId])
  @@index([agentId])
  @@index([campaignId])
}

model AgentTarget {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    Float // Target value for the period
  startDate DateTime // When this target became effective
  endDate   DateTime? // When this target ended (null = current)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([startDate])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HALFDAY
}

model Attendance {
  id         String           @id @default(uuid())
  agentId    String // User ID of the agent
  campaignId String // Campaign the agent belongs to
  date       DateTime // Date of attendance
  status     AttendanceStatus @default(PRESENT)
  remarks    String? // Optional notes (e.g., "sick leave", "vacation")
  createdBy  String // Collector who recorded this
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([agentId, date]) // One attendance record per agent per day
  @@index([agentId])
  @@index([campaignId])
  @@index([date])
  @@index([status])
}
