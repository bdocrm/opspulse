generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CEO
  SMT
  COLLECTOR
  OM
  AGENT
}

model User {
  id                          String                      @id @default(uuid())
  name                        String
  email                       String                      @unique
  password                    String
  role                        Role
  // Legacy / "primary" campaign. Kept for backward compatibility: every code
  // path that read a single campaign still works, and it mirrors the first
  // entry of the multi-campaign assignment (see UserCampaign). For COLLECTOR/OM
  // users the full set of assigned campaigns lives in `campaignAssignments`.
  campaignId                  String?
  campaign                    Campaign?                   @relation(fields: [campaignId], references: [id])
  campaignAssignments         UserCampaign[] // Multi-campaign assignment (collectors/managers)
  seatNumber                  Int?
  monthlyTarget               Float? // Current target for this agent (NTB target for ACQ campaigns)
  monthlyTargetSupplementary  Float? // ACQ: Supplementary target for this agent
  // MB PL per-agent goals (auto-filled from level, overridable)
  mbLevel                     String? // PAYROLL SU2 / PAYROLL HYBRID-ROOKIE / DEPO HYBRID / PAYROLL HYBRID
  disbursedTxnTarget          Float?
  disbursedVolTarget          Float?
  grossTurnInsTxnTarget       Float?
  grossTurnInsVolTarget       Float?
  dailySales                  DailySales[]
  targetHistory               AgentTarget[]
  productionDetails           ProductionDetail[] // AGENT produces production details
  normalizedProductionRecords ProductionMetricRecord[]
  collectorKpiRecords         CollectorKpiRecord[]        @relation("EmployeeKpiRecords")
  kpiImportBatches            KpiImportBatch[]            @relation("KpiImports")
  productionImports           ProductionImport[]          @relation("ProductionImports")
  productionMonitoringAudits  ProductionMonitoringAudit[] @relation("ProductionMonitoringChanges")
  campaignMappingsCreated     CampaignMapping[]           @relation("CampaignMappingCreatedBy")
  campaignMappingsUpdated     CampaignMapping[]           @relation("CampaignMappingUpdatedBy")
  campaignMappingAudits       CampaignMappingAudit[]      @relation("CampaignMappingAuditUser")
  mappedProductionRecords     ProductionMonitoring[]      @relation("ProductionMonitoringImportedBy")
  createdAt                   DateTime                    @default(now())

  @@index([campaignId])
}

// Explicit many-to-many join between users and campaigns. Lets a single
// collector/manager be assigned to multiple campaigns at once while the legacy
// User.campaignId continues to hold the "primary" campaign for backward
// compatibility. The unique constraint guarantees no duplicate assignments.
model UserCampaign {
  id         String   @id @default(uuid())
  userId     String
  campaignId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, campaignId])
  @@index([userId])
  @@index([campaignId])
}

model Campaign {
  id                          String                   @id @default(uuid())
  campaignName                String
  normalizedName              String?                  @unique
  isActive                    Boolean                  @default(true)
  goalType                    String
  monthlyGoal                 Float // Legacy field, kept for backwards compatibility
  supplementaryGoal           Float                    @default(0) // ACQ: monthly Supplementary goal (NTB uses monthlyGoal)
  kpiMetric                   String // Legacy field, kept for backwards compatibility
  workingDays                 Int                      @default(22) // Configurable working days per month
  daysLapsed                  Int                      @default(0) // Manually set days lapsed for run rate
  metrics                     CampaignMetric[] // New: Multiple KPI metrics per campaign
  monthlyGoals                CampaignGoal[] // Per-month goal configurations
  users                       User[]
  userAssignments             UserCampaign[] // Multi-campaign assignment (collectors/managers)
  dailySales                  DailySales[]
  productionDetails           ProductionDetail[] // Production details for this campaign
  normalizedProductionRecords ProductionMetricRecord[]
  collectorKpiRecords         CollectorKpiRecord[]
  kpiImportBatches            KpiImportBatch[]
  businessUnits               BusinessUnit[]
  productionMonitoringRecords ProductionMonitoring[]
  productionAliases           CampaignAlias[]
  campaignMappings            CampaignMapping[]
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @default(now()) @updatedAt
}

// Production Monitoring is deliberately campaign/business-unit centric. No
// Operations Manager identity or assignment is stored anywhere in this model
// graph so historical production remains independent from staffing changes.
model BusinessUnit {
  id                String                 @id @default(uuid())
  campaignId        String
  campaign          Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  businessUnitName  String
  normalizedName    String
  isActive          Boolean                @default(true)
  aliases           BusinessUnitAlias[]
  productionRecords ProductionMonitoring[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @default(now()) @updatedAt

  @@unique([campaignId, normalizedName])
  @@index([campaignId, isActive])
}

model CampaignAlias {
  id              String   @id @default(uuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  alias           String
  normalizedAlias String   @unique
  createdAt       DateTime @default(now())

  @@index([campaignId])
}

model BusinessUnitAlias {
  id              String       @id @default(uuid())
  businessUnitId  String
  businessUnit    BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  campaignId      String
  alias           String
  normalizedAlias String
  createdAt       DateTime     @default(now())

  @@unique([campaignId, normalizedAlias])
  @@index([businessUnitId])
}

model ProductionMonitoring {
  id                 String                      @id @default(uuid())
  campaignId         String
  campaign           Campaign                    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  businessUnitId     String
  businessUnit       BusinessUnit                @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  reportYear         Int
  reportMonth        Int
  reportPeriod       DateTime
  metricType         String
  metricUnit         String?
  target             Float?
  week1              Float?
  week2              Float?
  week3              Float?
  week4              Float?
  week5              Float?
  mtd                Float?
  achievement        Float?
  runRate            Float?
  workingDays        Int?
  daysLapse          Int?
  dateUpdated        DateTime?
  sourceType         String                      @default("EXCEL")
  sourceFile         String?
  sourceSheet        String?
  sourceRow          Int?
  sourceHash         String?
  sourceAccount      String?
  sourceCampaign     String?
  campaignMappingId  String?
  campaignMapping    CampaignMapping?            @relation(fields: [campaignMappingId], references: [id], onDelete: SetNull)
  productionImportId String?
  productionImport   ProductionImport?           @relation(fields: [productionImportId], references: [id], onDelete: SetNull)
  importedById       String?
  importedBy         User?                       @relation("ProductionMonitoringImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @default(now()) @updatedAt
  audits             ProductionMonitoringAudit[]

  @@unique([campaignId, businessUnitId, reportYear, reportMonth, metricType])
  @@index([campaignId, reportYear, reportMonth])
  @@index([businessUnitId, reportYear, reportMonth])
  @@index([metricType])
  @@index([dateUpdated])
  @@index([campaignMappingId])
  @@index([productionImportId])
  @@index([importedById])
}

model ProductionImport {
  id                String                  @id @default(uuid())
  fileName          String
  reportingPeriods  Json
  recordsDetected   Int                     @default(0)
  recordsImported   Int                     @default(0)
  recordsUpdated    Int                     @default(0)
  recordsUnchanged  Int                     @default(0)
  recordsSkipped    Int                     @default(0)
  warningCount      Int                     @default(0)
  errorCount        Int                     @default(0)
  status            String
  importedById      String
  importedBy        User                    @relation("ProductionImports", fields: [importedById], references: [id])
  issues            ProductionImportIssue[]
  productionRecords ProductionMonitoring[]
  mappingAudits     CampaignMappingAudit[]
  createdAt         DateTime                @default(now())
  completedAt       DateTime?

  @@index([importedById, createdAt])
  @@index([status, createdAt])
}

// Account-scoped campaign resolution for Production Monitoring imports. The
// composite unique key deliberately prevents a second mapping for the same
// normalized source pair; disabled mappings are re-enabled or remapped rather
// than duplicated.
model CampaignMapping {
  id                       String                 @id @default(uuid())
  sourceAccount            String
  normalizedSourceAccount  String
  sourceCampaign           String
  normalizedSourceCampaign String
  sourceSystem             String                 @default("PRODUCTION_MONITORING")
  opsviewCampaignId        String
  opsviewCampaign          Campaign               @relation(fields: [opsviewCampaignId], references: [id], onDelete: Restrict)
  status                   String                 @default("ACTIVE")
  mappingType              String                 @default("MANUAL")
  notes                    String?
  createdById              String
  createdBy                User                   @relation("CampaignMappingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById              String
  updatedBy                User                   @relation("CampaignMappingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  lastUsedAt               DateTime?
  usageCount               Int                    @default(0)
  audits                   CampaignMappingAudit[]
  productionRecords        ProductionMonitoring[]

  @@unique([sourceSystem, normalizedSourceAccount, normalizedSourceCampaign], map: "CampaignMapping_source_pair_key")
  @@index([normalizedSourceAccount, normalizedSourceCampaign, status])
  @@index([opsviewCampaignId, status])
}

model CampaignMappingAudit {
  id            String            @id @default(uuid())
  mappingId     String
  mapping       CampaignMapping   @relation(fields: [mappingId], references: [id], onDelete: Cascade)
  action        String
  oldCampaignId String?
  newCampaignId String?
  importId      String?
  import        ProductionImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  changedById   String
  changedBy     User              @relation("CampaignMappingAuditUser", fields: [changedById], references: [id], onDelete: Restrict)
  details       Json?
  createdAt     DateTime          @default(now())

  @@index([mappingId, createdAt])
  @@index([changedById, createdAt])
  @@index([importId])
}

model ProductionImportIssue {
  id          String           @id @default(uuid())
  importId    String
  import      ProductionImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  sourceSheet String?
  sourceRow   Int?
  level       String
  code        String
  message     String
  rawData     Json?
  createdAt   DateTime         @default(now())

  @@index([importId, level])
}

model ProductionMonitoringAudit {
  id                     String               @id @default(uuid())
  productionMonitoringId String
  productionMonitoring   ProductionMonitoring @relation(fields: [productionMonitoringId], references: [id], onDelete: Cascade)
  fieldChanged           String
  oldValue               String?
  newValue               String?
  changedById            String
  changedBy              User                 @relation("ProductionMonitoringChanges", fields: [changedById], references: [id])
  reason                 String
  createdAt              DateTime             @default(now())

  @@index([productionMonitoringId, createdAt])
  @@index([changedById, createdAt])
}

model ProductionMetricTypeConfig {
  metricType  String   @id
  label       String
  defaultUnit String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

// Per-(campaign, month, year) goal configuration. Lets the same campaign keep
// independent monthly goal / run-rate settings (e.g. BPI PA OUTBOUND → January
// vs February). When a row is absent for a given month, callers fall back to the
// legacy Campaign-level fields for backward compatibility.
model CampaignGoal {
  id                String   @id @default(uuid())
  campaignId        String
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  month             Int // 1-12
  year              Int
  monthlyGoal       Float    @default(0)
  supplementaryGoal Float    @default(0) // ACQ: per-month Supplementary goal
  kpiMetric         String   @default("transmittals")
  workingDays       Int      @default(22)
  daysLapsed        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([campaignId, month, year])
  @@index([campaignId])
}

model CampaignMetric {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  metricName  String // e.g., "transmittals", "approvals", "activations", "booked"
  monthlyGoal Float // Goal for this specific metric
  createdAt   DateTime @default(now())

  @@unique([campaignId, metricName]) // One metric type per campaign
  @@index([campaignId])
}

model DailySales {
  id             String   @id @default(uuid())
  userId         String
  campaignId     String
  date           DateTime
  transmittals   BigInt   @default(0)
  activations    BigInt   @default(0)
  approvals      BigInt   @default(0)
  booked         BigInt   @default(0)
  qualityRate    Float?
  conversionRate Float?
  volume         BigInt   @default(0)
  transaction    BigInt   @default(0)
  present        Boolean  @default(true)
  absent         Boolean  @default(false)
  user           User     @relation(fields: [userId], references: [id])
  campaign       Campaign @relation(fields: [campaignId], references: [id])
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([campaignId])
  @@index([date])
}

model ProductionEntry {
  id               String                   @id @default(uuid())
  campaignId       String
  date             DateTime // Date of entry (e.g., 2026-03-05)
  time             String // Time string (e.g., "2:36 PM")
  createdBy        String // Collector ID
  periodStart      DateTime? // Start of the reporting period (e.g. MTD May 1) for bulk imports
  periodEnd        DateTime? // End of the reporting period (e.g. MTD May 31) for bulk imports
  importFileName   String? // Original uploaded file name for bulk imports
  importMetricType String? // Metric mode used for the import
  reportPeriodType String                   @default("daily")
  details          ProductionDetail[]
  metricRecords    ProductionMetricRecord[]
  createdAt        DateTime                 @default(now())

  @@index([campaignId])
  @@index([date])
}

model ProductionMetricRecord {
  id                 String          @id @default(uuid())
  productionEntryId  String
  productionEntry    ProductionEntry @relation(fields: [productionEntryId], references: [id], onDelete: Cascade)
  campaignId         String
  campaign           Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  agentId            String
  agent              User            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reportPeriodType   String
  reportDate         DateTime
  reportMonth        Int?
  reportYear         Int
  metricType         String
  cardLevel          String          @default("")
  cardLevelLabel     String?
  grandTotal         BigInt?
  sourceNickname     String?
  finalTotal         BigInt?
  firstPeriodTotal   BigInt?
  secondPeriodTotal  BigInt?
  workbookGrandTotal BigInt?
  ranking            Int?
  monthValues        Json?
  count              BigInt?
  volume             BigInt?
  goal               Float?
  actual             Float?
  achievement        Float?
  sourceFile         String
  sourceSheet        String
  sourceRow          Int?
  createdAt          DateTime        @default(now())

  @@unique([campaignId, agentId, metricType, reportPeriodType, reportDate, cardLevel])
  @@index([productionEntryId])
  @@index([campaignId, reportYear, reportMonth])
  @@index([agentId])
}

model DashboardImportBatch {
  id                  String                  @id @default(uuid())
  campaignId          String
  fileName            String
  importMode          String
  duplicateMode       String
  reportPeriodType    String
  reportDate          DateTime
  workbookYear        Int?
  totalWorksheets     Int                     @default(0)
  supportedSheets     Int                     @default(0)
  selectedCampaignIds String?
  detectedWorksheets  String?
  duplicateCount      Int                     @default(0)
  unmappedCount       Int                     @default(0)
  insertedCount       Int                     @default(0)
  updatedCount        Int                     @default(0)
  skippedCount        Int                     @default(0)
  failedCount         Int                     @default(0)
  importedById        String
  status              String
  createdAt           DateTime                @default(now())
  completedAt         DateTime?
  records             DashboardImportRecord[]
  issues              DashboardImportIssue[]

  @@index([campaignId, reportDate])
  @@index([importedById, createdAt])
}

model DashboardImportRecord {
  id               String               @id @default(uuid())
  batchId          String
  batch            DashboardImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  campaignId       String
  worksheetSource  String
  sourceRow        Int
  recordKind       String
  monitoringType   String?
  entityName       String               @default("")
  level            String?
  category         String               @default("")
  product          String               @default("")
  metric           String
  month            Int?
  year             Int
  reportPeriodType String
  reportDate       DateTime
  target           Float?
  actual           Float?
  achievement      Float?
  numericValue     Float?
  declaredSeat     Float?
  actualHeadCount  Float?
  remark           String?
  sourceFile       String
  importedById     String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([campaignId, worksheetSource, recordKind, entityName, category, product, metric, year, month, reportPeriodType], map: "DashboardImportRecord_natural_key")
  @@index([campaignId, year, month])
  @@index([campaignId, year, month, metric])
  @@index([entityName])
  @@index([batchId])
  @@index([batchId, monitoringType])
}

model DashboardImportIssue {
  id              String               @id @default(uuid())
  batchId         String
  batch           DashboardImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  worksheetSource String
  sourceRow       Int?
  message         String
  rawValue        String?
  createdAt       DateTime             @default(now())

  @@index([batchId])
}

// Period snapshots for quality and productivity KPIs imported from workbooks.
// Goal values live on the record so historical results do not change when a
// campaign target changes later.
model CollectorKpiRecord {
  id                   String           @id @default(uuid())
  employeeId           String
  employee             User             @relation("EmployeeKpiRecords", fields: [employeeId], references: [id], onDelete: Cascade)
  employeeNameSnapshot String
  campaignId           String
  campaign             Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  month                Int
  year                 Int
  periodDate           DateTime
  tenure               String?
  actualQa             Float?
  actualAht            Float?
  actualAdherence      Float?
  actualCm             Float?
  actualCd             Float?
  goalQa               Float?
  goalAht              Float?
  goalAdherence        Float?
  goalCm               Float?
  goalCd               Float?
  achievementQa        Float?
  achievementAht       Float?
  achievementAdherence Float?
  achievementCm        Float?
  achievementCd        Float?
  overallScore         Float?
  importBatchId        String
  importBatch          KpiImportBatch   @relation(fields: [importBatchId], references: [id])
  auditEvents          KpiImportEvent[]
  sourceSheet          String
  sourceRow            Int
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([employeeId, campaignId, year, month])
  @@index([campaignId, year, month])
  @@index([employeeId, periodDate])
  @@index([importBatchId])
}

model KpiImportBatch {
  id               String               @id @default(uuid())
  originalFileName String
  campaignId       String
  campaign         Campaign             @relation(fields: [campaignId], references: [id])
  uploadedById     String
  uploadedBy       User                 @relation("KpiImports", fields: [uploadedById], references: [id])
  periodStart      DateTime?
  periodEnd        DateTime?
  totalRows        Int                  @default(0)
  successfulRows   Int                  @default(0)
  updatedRows      Int                  @default(0)
  skippedRows      Int                  @default(0)
  failedRows       Int                  @default(0)
  duplicateRows    Int                  @default(0)
  unmatchedRows    Int                  @default(0)
  warningRows      Int                  @default(0)
  duplicateMode    String               @default("SKIP")
  status           String
  startedAt        DateTime             @default(now())
  completedAt      DateTime?
  createdAt        DateTime             @default(now())
  records          CollectorKpiRecord[]
  issues           KpiImportIssue[]
  events           KpiImportEvent[]

  @@index([campaignId, createdAt])
  @@index([uploadedById, createdAt])
}

model KpiImportIssue {
  id           String         @id @default(uuid())
  batchId      String
  batch        KpiImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourceSheet  String
  sourceRow    Int?
  employeeName String?
  kind         String
  message      String
  rawData      Json?
  createdAt    DateTime       @default(now())

  @@index([batchId])
}

model KpiImportEvent {
  id           String              @id @default(uuid())
  batchId      String
  batch        KpiImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  recordId     String?
  record       CollectorKpiRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  employeeId   String
  employeeName String
  action       String
  oldValues    Json?
  newValues    Json?
  reason       String?
  sourceSheet  String
  sourceRow    Int
  createdAt    DateTime            @default(now())

  @@index([batchId])
  @@index([recordId])
  @@index([employeeId, createdAt])
}

model ProductionDetail {
  id                          String          @id @default(uuid())
  productionEntryId           String
  productionEntry             ProductionEntry @relation(fields: [productionEntryId], references: [id], onDelete: Cascade)
  agentId                     String
  agent                       User            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  campaignId                  String // Direct reference to campaign for easier filtering
  campaign                    Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  transmittals                BigInt          @default(0)
  activations                 BigInt          @default(0)
  approvals                   BigInt          @default(0)
  booked                      BigInt          @default(0)
  qualityRate                 Float?
  conversionRate              Float?
  volume                      BigInt          @default(0)
  transmittedVolume           BigInt          @default(0)
  approvalsVolume             BigInt          @default(0)
  bookedVolume                BigInt          @default(0)
  sourceSheet                 String?
  agentCode                   String?
  agentLevel                  String?
  dateHired                   DateTime?
  agentType                   String?
  monthlyGoal                 Float?
  monthlyActual               Float?
  monthlyAchievement          Float?
  overallGoal                 Float?
  overallActual               Float?
  overallAchievement          Float?
  transaction                 BigInt          @default(0)
  ntb                         BigInt          @default(0) // ACQ: New-To-Bank accounts
  supplementary               BigInt          @default(0) // ACQ: supplementary accounts
  seatCategory                String? // ACQ: BILLABLE / BUFFER
  cardLevel                   String          @default("") // BDO SGM: FIRST_CARD / BUNDLE_CARD
  cardLevelLabel              String?
  cardLevelGrandTotal         BigInt?
  sourceNickname              String?
  cardLevelFinalTotal         BigInt?
  cardLevelFirstPeriodTotal   BigInt?
  cardLevelSecondPeriodTotal  BigInt?
  cardLevelWorkbookGrandTotal BigInt?
  cardLevelRanking            Int?
  cardLevelMonthValues        Json?
  // MB PL wide-format: per-category transaction counts + volume
  bauPayrollTxn               BigInt          @default(0)
  bauPayrollVol               BigInt          @default(0)
  bauDepositorTxn             BigInt          @default(0)
  bauDepositorVol             BigInt          @default(0)
  topupPayrollTxn             BigInt          @default(0)
  topupPayrollVol             BigInt          @default(0)
  topupDepositorTxn           BigInt          @default(0)
  topupDepositorVol           BigInt          @default(0)
  openMarketTxn               BigInt          @default(0)
  openMarketVol               BigInt          @default(0)
  // MB PA wide-format: TOTAL (C2G / BT / BalCon PA) + GRAND TOTAL
  c2gTxn                      BigInt          @default(0)
  c2gVol                      BigInt          @default(0)
  btTxn                       BigInt          @default(0)
  btVol                       BigInt          @default(0)
  balconTxn                   BigInt          @default(0)
  balconVol                   BigInt          @default(0)
  grandTotalTxn               BigInt          @default(0)
  grandTotalVol               BigInt          @default(0)
  createdAt                   DateTime        @default(now())

  @@unique([productionEntryId, agentId, cardLevel])
  @@index([productionEntryId])
  @@index([agentId])
  @@index([campaignId])
}

model AgentTarget {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    Float // Target value for the period
  startDate DateTime // When this target became effective
  endDate   DateTime? // When this target ended (null = current)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([startDate])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HALFDAY
}

model Attendance {
  id         String           @id @default(uuid())
  agentId    String // User ID of the agent
  campaignId String // Campaign the agent belongs to
  date       DateTime // Date of attendance
  status     AttendanceStatus @default(PRESENT)
  remarks    String? // Optional notes (e.g., "sick leave", "vacation")
  createdBy  String // Collector who recorded this
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([agentId, date]) // One attendance record per agent per day
  @@index([agentId])
  @@index([campaignId])
  @@index([date])
  @@index([status])
}
