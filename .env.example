# ---- Database (Supabase / Neon PostgreSQL) ----
DATABASE_URL="postgresql://postgres:<PASSWORD>@<HOST>:5432/opsview"

# ---- NextAuth ----
# Generate a random secret, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET="generate-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ---- Optional: structured logging level ----
# debug | info | warn | error (defaults to info in production, debug in dev)
LOG_LEVEL="info"
